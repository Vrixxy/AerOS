 static void
+xcb_put_shm_pixels(void)
+{
+    xcb_connection_t *connection = s_display->xcb.connection;
+    if (!s_window->shm.gc) {
+        s_window->shm.gc = xcb_generate_id(connection);
+        xcb_create_gc(connection, s_window->shm.gc, s_window->xcb.window, 0, NULL);
+        xcb_get_geometry_reply_t *geometry =
+            xcb_get_geometry_reply(connection, xcb_get_geometry(connection, s_window->xcb.window), NULL);
+        s_window->shm.depth = geometry ? geometry->depth : 24;
+        free(geometry);
+    }
+    uint32_t room = xcb_get_maximum_request_length(connection) * 4 - 64;
+    int32_t rows = MAX(1, (int32_t) (room / s_window->shm.stride));
+    for (int32_t y = 0; y < s_window->shm.height; y += rows) {
+        int32_t count = MIN(rows, s_window->shm.height - y);
+        xcb_put_image(connection, XCB_IMAGE_FORMAT_Z_PIXMAP, s_window->xcb.window, s_window->shm.gc,
+                      s_window->shm.stride / 4, count, 0, y, 0, s_window->shm.depth, count * s_window->shm.stride,
+                      s_window->shm.pixels + (size_t) y * s_window->shm.stride);
+    }
+    xcb_flush(connection);
+}
+
+static void
 xcb_paint_image (struct wpe_fdo_egl_exported_image *image)
 {
+    if (image == NULL && s_window->shm.pixels) {
+        s_window->xcb.needs_repaint = false;
+        xcb_put_shm_pixels();
+        return;
+    }
+
     eglMakeCurrent (s_display->egl.display, s_window->egl.surface, s_window->egl.surface, s_display->egl.context);
 
     glViewport (0, 0, s_window->xcb.width, s_window->xcb.height);
